# Copiar este archivo como .env.local y completar con los datos del proyecto
# (Supabase → Project Settings → API Keys). La clave publishable es pública:
# la seguridad de los datos la dan las políticas RLS de la base.
VITE_SUPABASE_URL=https://<id-del-proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
