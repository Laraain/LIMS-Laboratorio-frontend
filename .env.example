# Copiar este archivo como .env y completar con los datos del proyecto
# (Supabase -> Project Settings). El archivo .env NO se sube a git: esta en el .gitignore.

# Direccion de la API REST de Supabase. La usa Axios en src/components/PerfilUsuario.jsx
VITE_API_URL=https://<id-del-proyecto>.supabase.co/rest/v1

# Cliente de Supabase (login). La clave publishable es publica:
# la seguridad de los datos la dan las politicas RLS de la base.
VITE_SUPABASE_URL=https://<id-del-proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
